# ─────────────────────────────────────────────
# BankLens — Environment Variable Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: override the default LLM model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: override the embedding model (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: directory where ChromaDB persists its data (default: ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# Optional: ChromaDB collection name (default: banking_products)
CHROMA_COLLECTION_NAME=banking_products

# Optional: RAG chunk size in characters (default: 500)
CHUNK_SIZE=500

# Optional: RAG chunk overlap in characters (default: 50)
CHUNK_OVERLAP=50

# Optional: number of chunks to retrieve per query (default: 3)
RETRIEVAL_K=3
