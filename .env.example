# ─────────────────────────────────────────────
# BankLens — Environment Variable Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Models ───────────────────────────────────

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: LLM used for profile synthesis (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: cheaper model used for the categorizer fallback, the reranker,
# the eval judge, and as the fallback when the primary model is unavailable
# (default: gpt-4o-mini)
OPENAI_MINI_MODEL=gpt-4o-mini

# Optional: embedding model for the dense half of retrieval
# (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Vector store ─────────────────────────────

# Optional: directory where ChromaDB persists its data (default: ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# Optional: ChromaDB collection name (default: banking_products)
CHROMA_COLLECTION_NAME=banking_products

# ── Retrieval ────────────────────────────────

# Optional: RAG chunk size in characters (default: 500)
CHUNK_SIZE=500

# Optional: RAG chunk overlap in characters (default: 50)
CHUNK_OVERLAP=50

# Optional: number of chunks passed to the LLM after reranking (default: 4)
RETRIEVAL_K=4

# Optional: candidates pulled from each retriever before reranking
# (default: 15). Retrieve wide, rerank narrow — measurements in
# evals/retrieval.py show the relevant document is often inside the candidate
# pool but outside the final cut, which is exactly what reranking recovers.
RETRIEVAL_CANDIDATE_K=15

# ── Reranking ────────────────────────────────

# Optional: which reranker to use (default: none)
#   llm            — listwise rerank with OPENAI_MINI_MODEL. No extra
#                    dependencies, ~1s added latency, fractions of a cent.
#   cross_encoder  — local cross-encoder. No API cost and lower latency, but
#                    requires sentence-transformers, which pulls in torch.
#                    Too heavy for a 1 GB t2.micro; use on a larger host.
#                    Install with: pip install sentence-transformers
#   none           — skip reranking and use the hybrid fusion order directly.
#
# Defaults to "none" because the A/B measured a regression, not a win: LLM
# reranking improves nDCG (+0.061) but drops hit rate (1.000 -> 0.923) and
# raises unsecured-credit content shown to cashflow-deficit customers from 1.0
# to 2.3 chunks out of 4. Reproduce with:
#     python -m evals.run_evals --retrieval-ab
RERANK_BACKEND=none

# Optional: model used when RERANK_BACKEND=cross_encoder
# (default: cross-encoder/ms-marco-MiniLM-L-6-v2)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: characters of each candidate passage shown to the reranker
# (default: 600)
RERANK_PASSAGE_CHARS=600

# ── Multi-Query Retrieval ────────────────────

# Optional: expand the retrieval query into facet rewrites and fuse with
# anchored RRF (default: true). Measured over the golden queries: nothing
# regresses — MRR +0.054, nDCG +0.009, harmful credit-content to deficit
# customers -11%. Costs one mini-model call + two extra retrievals. Reproduce:
#     python -m evals.run_evals --multi-query-ab
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=2

# ── Vision OCR for scanned PDFs (Engine 3) ───

# Optional: read scanned statements with the vision model (default: false).
# OFF by default deliberately: the PII sanitizer masks text before it reaches
# an external model, but a page image cannot be masked — enabling this sends
# the raw statement image to the vision API. Text extracted back IS sanitized
# before profiling.
VISION_OCR_ENABLED=false
VISION_OCR_MAX_PAGES=4

# ── Profile Response Cache ───────────────────

# Optional: exact-key cache over (metrics, chunks, prompt, model) so identical
# statements return identical profiles without a second GPT-4o call
# (default: true). Not semantic caching, on purpose — similar statements are
# different customers. Prompt or model changes invalidate automatically.
PROFILE_CACHE_ENABLED=true
PROFILE_CACHE_DIR=./.profile_cache

# ── Tracing (optional) ───────────────────────

# Set to "true" to send traces to LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=BankLens
